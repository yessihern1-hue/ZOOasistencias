# Copia estos valores desde la configuración API de tu proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLISHABLE
# En proyectos anteriores puedes usar NEXT_PUBLIC_SUPABASE_ANON_KEY en su lugar.

# Solo para acciones administrativas del servidor, como invitar/crear usuarios.
# Nunca uses esta variable en componentes cliente ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=TU_CLAVE_SECRETA_DEL_SERVIDOR

# Protege el endpoint diario de retención de fotografías. Usa al menos 16 caracteres.
CRON_SECRET=GENERA_UN_SECRETO_ALEATORIO_LARGO
